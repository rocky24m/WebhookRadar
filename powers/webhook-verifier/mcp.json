{
  "mcpServers": {
    "sqlite": {
      "command": "node",
      "args": [
        "scripts/mcp-sqlite-server.mjs",
        "--db-path",
        "data/webhooks.db"
      ],
      "disabled": false
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "disabled": false
    }
  }
}
